# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ─── Admin Authentication ─────────────────────────────────────────────
# Multi-admin: JSON array of { username, password }. Each password supports
# plaintext (local dev) or a bcrypt hash ($2a$/$2b$/$2y$...) for production.
#   ADMIN_USERS='[{"username":"admin@grizolabs.app","password":"ChangeThis123!"}]'
#
# Single-admin fallback (used when ADMIN_USERS is not set):
# ADMIN_USERNAME: Login username for the /admin dashboard.
ADMIN_USERNAME="admin@grizolabs.app"

# ADMIN_PASSWORD:
#   - Plaintext supported for quick local setup (server compares directly).
#   - For production, set a bcrypt hash ($2a$/$2b$/$2y$...). Generate one with:
#       htpasswd -bnBC 10 "" "your-password" | tr -d ':\n'
#     or `npx bcrypt-cli <password>`.
ADMIN_PASSWORD="ChangeThis123!"

# SESSION_SECRET: Strong secret used to sign JWT + sessions.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# COOKIE_SECURE: Set "false" to allow the auth cookie over plain HTTP (e.g.
# testing a local production build). Defaults to true when NODE_ENV=production.
# COOKIE_SECURE="false"

# ─── Security / Hardening ─────────────────────────────────────────────
# CORS allowlist (comma-separated origins). Origins not listed here receive
# NO CORS headers. Same-origin requests are always allowed.
#   CORS_ORIGINS="http://localhost:5173,https://grizolabs.com"
# Falls back to FRONTEND_URL when unset.
# FRONTEND_URL="http://localhost:5173"

# TRUST_PROXY: Set to "true" when running behind a reverse proxy (e.g. Cloud
# Run, nginx) so rate-limiters use the real client IP via X-Forwarded-For.
TRUST_PROXY="false"

# API_RATE_LIMIT_MAX: Max requests per IP per 15 minutes across all /api routes.
API_RATE_LIMIT_MAX="300"

# AUTH_RATE_LIMIT_MAX: Max login attempts per IP per 15 minutes.
AUTH_RATE_LIMIT_MAX="5"

# ─── Database (PostgreSQL via Neon) ────────────────────────────────────
# DATABASE_URL: Neon pooled connection string.
# 1. Create a project at https://neon.tech (free tier is enough).
# 2. Copy the "Pooled connection" string from the dashboard (ends in
#    ?sslmode=require, using the -pooler host for the app).
# 3. Optional: append a `-dev` branch DB for local development.
#
# When unset, the app runs WITHOUT persistence:
#   - lead/admin APIs return 503, audit log falls back to logs/audit.log
#   - admin portal uses the built-in mock data
# DATABASE_URL="postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/dbname?sslmode=require"
